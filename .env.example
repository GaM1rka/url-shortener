# Скопируйте в .env и запускайте приложение из корня проекта.
HTTP_ADDRESS=:8081
HTTP_BASE_URL=http://localhost:8081

HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Допустимые значения: memory, postgres. По умолчанию memory, БД не нужна.
STORAGE_TYPE=memory

# Обязательно только при STORAGE_TYPE=postgres.
POSTGRES_DSN=postgres://url_shortener:url_shortener@localhost:5432/url_shortener?sslmode=disable
